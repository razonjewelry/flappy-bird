{
  "expo": {
    "name": "המשימות שלנו",
    "slug": "or-ziv-tasks",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "scheme": "orzivtasks",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.razon.orzivtasks"
    },
    "android": {
      "package": "com.razon.orzivtasks",
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "המשימות שלנו",
      "shortName": "המשימות",
      "lang": "he",
      "themeColor": "#D4AF37",
      "backgroundColor": "#121212",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#121212"
        }
      ]
    ]
  }
}